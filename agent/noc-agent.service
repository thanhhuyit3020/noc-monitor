[Unit]
Description=NOC Monitoring Agent
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=nocagent
Group=nocagent
EnvironmentFile=/etc/noc-agent.env
ExecStart=/opt/noc-agent/.venv/bin/python /opt/noc-agent/run_agent.py --interval 15
Restart=always
RestartSec=10
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
